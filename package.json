{
  "name": "sidequest-worlds",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-music.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/sync-music.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "music:sync": "node scripts/sync-music.mjs",
    "voxelbloom:build": "npm --prefix voxelbloom run build && node scripts/sync-voxelbloom.mjs",
    "voxelbloom:sync": "node scripts/sync-voxelbloom.mjs",
    "second-pour:build": "npm --prefix second-pour run build && node scripts/sync-second-pour.mjs",
    "second-pour:sync": "node scripts/sync-second-pour.mjs",
    "check:loom": "node loom/checks.cjs",
    "check:loom-amp": "node loom/amp-checks.cjs",
    "check:loom-vocal": "node loom/vocal-checks.cjs",
    "check:loom-vocal-browser": "node loom/vocal-browser-checks.cjs",
    "check:loom-utility": "node loom/utility-checks.cjs",
    "check:loom-utility-integration": "node loom/utility-integration-checks.cjs",
    "check:loom-utility-browser": "node loom/utility-browser-checks.cjs",
    "check:batter": "node batter/engine-checks.cjs",
    "check:loom-batter": "node loom/batter-integration-checks.cjs",
    "check:batter-browser": "node batter/browser-checks.cjs",
    "check:loom-mic": "node loom/microphone-engine-checks.cjs",
    "check:loom-mic-browser": "node loom/microphone-browser-checks.cjs",
    "check:loom-interface": "node loom/audio-interface-checks.cjs",
    "check:loom-interface-browser": "node loom/audio-interface-browser-checks.cjs",
    "package": "node scripts/package-downloads.mjs",
    "check:fable": "node fable/checks.cjs",
    "check:fable-audio": "node fable/engine-checks.cjs",
    "check:fable-zip": "node fable/zip-checks.cjs",
    "check:patterns": "node shared/pattern-checks.cjs",
    "check:patterns-drums": "node shared/pattern-drums-checks.cjs",
    "check:loom-notes": "node loom/note-checks.cjs",
    "check:tine-export": "node tine/export-checks.cjs",
    "check:roux": "node roux/engine-checks.cjs",
    "check:roux-browser": "node roux/browser-checks.cjs",
    "check:hotplate": "npm --prefix form test && npm --prefix form run test:sequencing",
    "check:hotplate-compat": "npm --prefix form run test:compat",
    "check:hotplate-browser": "npm --prefix form run test:overhaul",
    "check:interfaces": "GALLEY_FILE=loom/index.html node shared/kitchen-interface-checks.cjs",
    "check:proof": "node proof/engine-checks.cjs",
    "check:proof-browser": "node proof/browser-checks.cjs",
    "check:marinade": "node marinade/engine-checks.cjs",
    "check:marinade-browser": "node marinade/browser-checks.cjs",
    "check:marinade-integration": "node marinade/integration-checks.cjs",
    "check:performance-audio": "node scripts/performance-audio-checks.cjs",
    "check:loom-service": "node loom/service-schema-checks.cjs && node loom/service-engine-checks.cjs && node loom/service-note-checks.cjs && node loom/service-capture-checks.cjs && node loom/service-midi-checks.cjs && node loom/service-controller-checks.cjs",
    "check:loom-service-browser": "node loom/service-browser-checks.cjs"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
