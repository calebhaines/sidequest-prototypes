{
  "name": "lady-supine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:campaign": "node scripts/validate-campaign.mjs",
    "test:browser": "node scripts/open-world-check.mjs",
    "test:layout": "node scripts/open-world-layout-check.mjs",
    "test:widgets": "node scripts/open-world-widget-check.mjs",
    "test:case-save": "node scripts/open-world-case-check.mjs",
    "test:quests": "node scripts/open-world-quests-check.mjs",
    "test:waypoints": "node scripts/open-world-waypoint-check.mjs",
    "test:production": "node scripts/open-world-production-check.mjs",
    "test:puzzles": "node scripts/open-world-widget-check.mjs --puzzles",
    "test:story": "node scripts/open-world-story-check.mjs",
    "test:investigations": "node scripts/open-world-widget-check.mjs --cases",
    "test:pacing": "node scripts/validate-investigations.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
